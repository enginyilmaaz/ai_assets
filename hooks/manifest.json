{
  "preamble": null,
  "hooks": [
    {
      "id": "voice-notify",
      "icon": "notifications_active",
      "order": 10,
      "name_en": "Notification sound on task completion",
      "name_tr": "Görev bitince bildirim sesi",
      "desc_en": "When a tool-using turn ends, plays a short notification sound (bundled notification.mp3). No text-to-speech. Plain chat replies stay silent.",
      "desc_tr": "Araç kullanan bir tur bitince kısa bir bildirim sesi çalar (paketteki notification.mp3). Konuşma-metni okuma yok. Düz sohbet yanıtlarında susar.",
      "event": "Stop",
      "files": [
        { "src": "voice-notify/notify-task-done.sh", "dest": "~/.claude/hooks/notify-task-done.sh", "chmod": "0755" },
        { "src": "voice-notify/notification.mp3", "dest": "~/.claude/hooks/notification.mp3", "chmod": "0644" }
      ],
      "settings": {
        "hooks": {
          "Stop": [
            { "hooks": [ { "type": "command", "command": "bash ~/.claude/hooks/notify-task-done.sh", "timeout": 15, "statusMessage": "Bildirim sesi..." } ] }
          ]
        }
      },
      "dependencies": []
    }
  ]
}
